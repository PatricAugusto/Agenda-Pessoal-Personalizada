{
  "name": "agenda-pessoal",
  "version": "1.1.1",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.74.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    },
    "glob": "14.0.2",
    "test-exclude@6.0.0": {
      "glob": "7.2.3"
    },
    "test-exclude@7.0.2": {
      "minimatch": "11.0.1"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:ci": "jest --coverage --runInBand --ci",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/components/**/*.{ts,tsx}",
      "src/lib/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/test/**",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      }
    },
    "coverageDirectory": "coverage"
  },
  "private": true
}
